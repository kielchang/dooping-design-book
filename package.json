{
  "name": "dooping-design-book",
  "version": "0.13.0",
  "private": true,
  "type": "module",
  "description": "Dooping Design Book — 跨專案設計語言、模式手冊與 React 參考實作",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:tokens": "npm run build --workspace @dooping/tokens",
    "build:theme": "node packages/tokens/scripts/generate-theme.mjs",
    "build:registry": "node scripts/build-registry.mjs",
    "registry:changes": "node scripts/registry-changes.mjs",
    "host:sync": "node scripts/host-sync.mjs",
    "host:check": "node scripts/host-sync.mjs --check",
    "verify:color": "node scripts/verify-color.mjs",
    "verify:book": "node scripts/verify-book-host.mjs",
    "verify:storybook": "node scripts/verify-storybook.mjs",
    "verify:visual": "node scripts/verify-visual.mjs",
    "verify:host": "node scripts/verify-host.mjs",
    "status": "node scripts/version-status.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspace @dooping/host-v4",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "book": "npm --prefix book run start",
    "build:book": "npm --prefix book run build",
    "build:all": "npm run build:tokens && npm run build:registry && npm run build-storybook && npm run build:book",
    "host:dev": "npm run dev --workspace @dooping/host-v4",
    "host:build": "npm run build --workspace @dooping/host-v4"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.6.18",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/react-vite": "^8.6.18",
    "@storybook/test": "^8.6.18",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.19.21",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.13.0",
    "playwright": "~1.56.0",
    "postcss": "^8.4.49",
    "storybook": "^8.6.18",
    "tailwindcss": "^4.3.3",
    "tailwindcss3": "npm:tailwindcss@^3.4.19",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.3.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.7"
}
