{
  "name": "@dooping/tokens",
  "version": "0.1.1",
  "description": "Dooping 設計 token — 框架中立的語意化設計變數（JSON 來源 → CSS 變數 + Tailwind preset）",
  "license": "MIT",
  "keywords": [
    "design-tokens",
    "design-system",
    "css-variables",
    "tailwindcss",
    "tailwind-preset",
    "theming",
    "dark-mode"
  ],
  "homepage": "https://kielchang.github.io/dooping-design-book/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kielchang/dooping-design-book.git",
    "directory": "packages/tokens"
  },
  "bugs": "https://github.com/kielchang/dooping-design-book/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.json": "./src/tokens.json",
    "./tokens.css": "./dist/tokens.css",
    "./tailwind-preset": "./tailwind-preset.cjs"
  },
  "files": [
    "dist",
    "src/tokens.json",
    "tailwind-preset.cjs",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-css.mjs && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  }
}
