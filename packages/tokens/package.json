{
  "name": "@doping/tokens",
  "version": "0.1.0",
  "description": "Doping 設計 token — 框架中立的語意化設計變數（JSON 來源 → CSS 變數 + Tailwind preset）",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.json": "./src/tokens.json",
    "./tokens.css": "./dist/tokens.css",
    "./tailwind-preset": "./tailwind-preset.cjs"
  },
  "files": [
    "dist",
    "src/tokens.json",
    "tailwind-preset.cjs"
  ],
  "scripts": {
    "build": "node scripts/build-css.mjs && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  }
}
