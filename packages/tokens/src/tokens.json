  "radius": {
    "$comment": "圓角以 --radius 為基準推導，換一個值即可整站從方到圓。",
    "base": {
      "value": "0.5rem"
    },
    "sm": {
      "value": "calc(var(--radius) - 4px)"
    },
    "md": {
      "value": "calc(var(--radius) - 2px)"
    },
    "lg": {
      "value": "var(--radius)"
    },
    "full": {
      "value": "9999px"
    }
  },
